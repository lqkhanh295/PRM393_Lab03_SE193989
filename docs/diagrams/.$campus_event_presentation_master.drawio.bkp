  <diagram id="13_Class_Design" name="13_Class_Design">
  <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" background="#ffffff">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      
      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:4px 8px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:800; color:#2563eb; background:#eff6ff; padding:3px 10px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe; letter-spacing:0.5px;&quot;&gt;SLIDE 13 • CLASS DESIGN&lt;/div&gt;
      &lt;div style=&quot;font-size:19px; font-weight:800; color:#0f172a; line-height:1.2; letter-spacing:-0.2px;&quot;&gt;13. CLASS DESIGN — THIẾT KẾ CÁC LỚP TRONG MÃ NGUỒN (MVVM)&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#475569; margin-top:3px; font-weight:500;&quot;&gt;Phân định trách nhiệm rõ ràng: Domain Models ➔ ViewModels (State) ➔ Business Services ➔ Cloud Layer&lt;/div&gt;
    &lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
        <mxGeometry x="40" y="15" width="1000" height="75" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_2" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;1. TẦNG DOMAIN MODELS (LIB/MODELS/)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Thực thể dữ liệu bất biến, chuyển đổi JSON/Firestore Map&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="40" y="100" width="470" height="980" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;EventModel&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Entity sự kiện trường FPT&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String id, title, description, location&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + DateTime date, String timeRange&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String clubName, category&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + int capacity, registeredCount&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String status // upcoming, happening, completed&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + bool get isPast =&amp;gt; DateTime.now().isAfter(date)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + bool get isRegistrationOpen&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + fromMap(Map json), toMap(): Map&amp;lt;String, dynamic&amp;gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="160" width="430" height="205" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_4" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#047857; line-height:1.3; word-break:break-word;&quot;&gt;TicketModel&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Entity vé điện tử sinh viên&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String id, eventId, eventTitle&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String userId, studentName, studentEmail&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String qrToken // mã băm bí mật&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + bool isUsed // cờ đánh dấu check-in&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + DateTime? checkedInAt&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + bool feedbackSubmitted&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + fromMap(Map json), toMap(): Map&amp;lt;String, dynamic&amp;gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="380" width="430" height="205" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_5" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;RegistrationModel (Slide 18)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Entity đơn đăng ký xét duyệt&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #8b5cf6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String id, eventId, userId&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String studentName, studentId, studentEmail&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String status // pending, approved, rejected&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String? rejectReason&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + DateTime createdAt, reviewedAt&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + fromMap(Map json), toMap(): Map&amp;lt;String, dynamic&amp;gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="600" width="430" height="205" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_6" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#0f172a; line-height:1.3; word-break:break-word;&quot;&gt;UserModel&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Entity tài khoản sinh viên FPT&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #64748b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String id, name, email, avatarUrl&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String major, role // student, admin, staff&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + int activityPoints // điểm rèn luyện&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + fromMap(Map json), toMap(): Map&amp;lt;String, dynamic&amp;gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="820" width="430" height="205" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_7" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:8px 10px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;2. TẦNG VIEWMODELS (LIB/VIEWMODELS/)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Kế thừa ChangeNotifier, quản lý trạng thái UI&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="545" y="100" width="490" height="980" as="geometry" />
      </mxCell>
    
      
