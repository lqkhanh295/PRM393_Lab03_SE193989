      <mxCell id="cell_15" value="mở khóa đánh giá (1,1 ➔ 0,1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#0f172a;labelBackgroundColor=#ffffff;labelBorderColor=#94a3b8;arcSize=4;" edge="1" parent="1" source="cell_6" target="cell_7">
        <mxGeometry relative="1" as="geometry">
          <mxPoint as="offset" x="0" y="-14" />
