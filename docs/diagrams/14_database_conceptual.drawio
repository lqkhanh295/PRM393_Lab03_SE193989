  <mxGraphModel dx="1450" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" background="#ffffff">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      
      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:8px 12px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:700; color:#2563eb; background:#eff6ff; padding:2px 8px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe;&quot;&gt;SLIDE 14 • DATABASE DESIGN 1/2&lt;/div&gt;
      &lt;div style=&quot;font-size:18px; font-weight:800; color:#0f172a; line-height:1.2;&quot;&gt;14. DATABASE DESIGN 1/2 — MÔ HÌNH DỮ LIỆU KHÁI NIỆM (CONCEPTUAL ERD)&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#64748b; margin-top:2px;&quot;&gt;Mô hình hóa ngữ nghĩa nghiệp vụ, thực thể, mối quan hệ và bản số (Cardinality) — Chưa phụ thuộc DBMS vật lý&lt;/div&gt;
    &lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
        <mxGeometry x="40" y="20" width="700" height="65" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_2" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;SINH VIÊN (USER)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Thực thể người học FPT&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #60a5fa; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã sinh viên (MSSV)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Họ và tên&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Email trường (@fpt.edu.vn)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Chuyên ngành đào tạo&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Điểm rèn luyện tích lũy&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="140" width="240" height="140" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;CÂU LẠC BỘ (CLUB)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Đơn vị tổ chức sự kiện&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #c084fc; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã định danh CLB&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Tên câu lạc bộ&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Tên viết tắt&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Lĩnh vực hoạt động&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Cán bộ chủ nhiệm&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#c084fc;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="400" width="240" height="140" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_4" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;SỰ KIỆN (EVENT)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Chương trình được phê duyệt&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #34d399; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã sự kiện&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Tên chủ đề sự kiện&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Ngày giờ diễn ra&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Địa điểm / Hội trường&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Sức chứa tối đa&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Hạn chót đăng ký&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Trạng thái vận hành&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="420" y="260" width="260" height="170" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_5" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;ĐƠN ĐĂNG KÝ (REGISTRATION)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Hồ sơ chờ duyệt (Slide 18)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #fbbf24; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã đơn đăng ký&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Thời điểm nộp đơn&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Trạng thái xét duyệt (pending/approved/rejected)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Lý do từ chối (nếu có)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Cán bộ xét duyệt&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fffbeb;strokeColor=#fbbf24;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="790" y="140" width="260" height="150" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_6" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;VÉ ĐIỆN TỬ (TICKET)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Vé vào cổng kèm mã bảo mật&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #34d399; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã vé điện tử&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Mã băm QR Token bí mật&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Trạng thái sử dụng (isUsed)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Thời điểm check-in cổng&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Đã gửi feedback hay chưa&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#34d399;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="790" y="400" width="260" height="160" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_7" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;ĐÁNH GIÁ (FEEDBACK)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Khảo sát chất lượng sự kiện&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #c084fc; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Mã phiếu đánh giá&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Điểm số hài lòng (1-5 sao)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Nhận xét &amp;amp; góp ý chi tiết&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Thời điểm nộp phiếu&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Điểm rèn luyện đã cộng (+5)&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#c084fc;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="1140" y="300" width="250" height="140" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_8" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;CHỨNG NHẬN (CERTIFICATE)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Chứng chỉ e-Cert số hóa&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #60a5fa; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• * Số hiệu chứng nhận&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Đường dẫn tệp PDF Cloud&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Mã băm kiểm định SHA-256&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • Ngày cấp chứng nhận&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="1140" y="490" width="250" height="140" as="geometry" />
      </mxCell>
    
      
