        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_12" value="phê duyệt sinh vé (0,1) ➔ (0,1) [Slide 18]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=10;fontColor=#1e293b;" edge="1" parent="1" source="cell_5" target="cell_6">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_13" value="phát hành (1,1) ➔ (0,N)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontColor=#1e293b;" edge="1" parent="1" source="cell_4" target="cell_6">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_14" value="sở hữu (1,1) ➔ (0,N)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontColor=#1e293b;" edge="1" parent="1" source="cell_2" target="cell_6">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_15" value="mở khóa đánh giá (1,1) ➔ (0,1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontColor=#1e293b;" edge="1" parent="1" source="cell_6" target="cell_7">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_16" value="cấp chứng nhận (1,1) ➔ (0,1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontColor=#1e293b;" edge="1" parent="1" source="cell_6" target="cell_8">
        <mxGeometry relative="1" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_17" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;CÁC QUY TẮC NGHIỆP VỤ (BUSINESS RULES) CHI PHỐI QUAN HỆ KHÁI NIỆM:&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Ràng buộc toàn vẹn dữ liệu được bảo vệ xuyên suốt từ mức thiết kế ý niệm đến ứng dụng thực tế&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #94a3b8; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • BR-01 (Định danh duy nhất): Mỗi Vé điện tử (Ticket) thuộc về duy nhất một Sinh viên (User) và một Sự kiện (Event). Một sinh viên không thể có 2 vé trong cùng 1 sự kiện.&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • BR-02 (Ràng buộc sức chứa): Tổng số Vé điện tử được phát hành của một Sự kiện không bao giờ vượt quá chỉ số Sức chứa tối đa (Capacity) của Sự kiện đó.&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • BR-03 (Thời hạn nộp đơn): Đơn đăng ký chỉ có thể được tạo khi thời điểm hiện tại nhỏ hơn hoặc bằng Hạn chót đăng ký của Sự kiện.&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • BR-04 (Quy trình duyệt vé Slide 18): Một Vé điện tử chỉ được khởi tạo khi và chỉ khi Đơn đăng ký (Registration) tương ứng chuyển sang trạng thái &amp;quot;approved&amp;quot; bởi Cán bộ CTSV.&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• • BR-05 (Ràng buộc Đánh giá &amp;amp; Chứng nhận): Phiếu Đánh giá (Feedback) và Chứng chỉ (Certificate) chỉ có thể được tạo sau khi Vé đã được xác thực Check-in cổng (isUsed == true).&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="680" width="1330" height="220" as="geometry" />
      </mxCell>
    
    </root>
