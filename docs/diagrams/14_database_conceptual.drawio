      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:4px 8px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:800; color:#2563eb; background:#eff6ff; padding:3px 10px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe; letter-spacing:0.5px;&quot;&gt;SLIDE 14 • DATABASE DESIGN 1/2&lt;/div&gt;
      &lt;div style=&quot;font-size:19px; font-weight:800; color:#0f172a; line-height:1.2; letter-spacing:-0.2px;&quot;&gt;14. DATABASE DESIGN 1/2 — MÔ HÌNH DỮ LIỆU KHÁI NIỆM (CONCEPTUAL ERD)&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#475569; margin-top:3px; font-weight:500;&quot;&gt;Mô hình hóa ngữ nghĩa nghiệp vụ, thực thể, mối quan hệ và bản số (Cardinality) — Chưa phụ thuộc DBMS vật lý&lt;/div&gt;
    &lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
        <mxGeometry x="40" y="15" width="1100" height="75" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_2" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;CÂU LẠC BỘ (CLUB)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Đơn vị tổ chức sự kiện&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #8b5cf6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã định danh CLB&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tên câu lạc bộ&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tên viết tắt&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Lĩnh vực hoạt động&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Cán bộ chủ nhiệm&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="140" width="280" height="175" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#047857; line-height:1.3; word-break:break-word;&quot;&gt;SỰ KIỆN (EVENT)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Chương trình được phê duyệt&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã sự kiện&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tên chủ đề sự kiện&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Ngày giờ diễn ra&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Địa điểm / Hội trường&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Sức chứa tối đa&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hạn chót đăng ký&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Trạng thái vận hành&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="480" y="140" width="320" height="195" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_4" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#b45309; line-height:1.3; word-break:break-word;&quot;&gt;ĐƠN ĐĂNG KÝ (REGISTRATION)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Hồ sơ chờ duyệt (Slide 18)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #f59e0b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã đơn đăng ký&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Thời điểm nộp đơn&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Trạng thái xét duyệt (pending/approved/rejected)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Lý do từ chối (nếu có)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Cán bộ xét duyệt&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
