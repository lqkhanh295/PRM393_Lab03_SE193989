      <mxCell id="cell_5" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;SINH VIÊN (USER)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Thực thể người học FPT&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã sinh viên (MSSV)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Họ và tên&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Email trường (@fpt.edu.vn)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Chuyên ngành đào tạo&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Điểm rèn luyện tích lũy&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="60" y="440" width="280" height="180" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_6" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#047857; line-height:1.3; word-break:break-word;&quot;&gt;VÉ ĐIỆN TỬ (TICKET)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Vé vào cổng kèm mã bảo mật&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã vé điện tử&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Mã băm QR Token bí mật&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Trạng thái sử dụng (isUsed)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Thời điểm check-in cổng&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Đã gửi feedback hay chưa&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="930" y="440" width="320" height="195" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_7" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;ĐÁNH GIÁ (FEEDBACK)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Khảo sát chất lượng sự kiện&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #8b5cf6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Mã phiếu đánh giá&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Điểm số hài lòng (1-5 sao)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Nhận xét &amp;amp; góp ý chi tiết&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Thời điểm nộp phiếu&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Điểm rèn luyện đã cộng (+5)&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="1320" y="340" width="250" height="155" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_8" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;CHỨNG NHẬN (CERTIFICATE)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Chứng chỉ e-Cert số hóa&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• * Số hiệu chứng nhận&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Đường dẫn tệp PDF Cloud&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Mã băm kiểm định SHA-256&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Ngày cấp chứng nhận&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="1320" y="530" width="250" height="155" as="geometry" />
      </mxCell>
    
      
