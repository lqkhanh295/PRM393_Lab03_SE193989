      <mxCell id="cell_23" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#0f172a; line-height:1.3; word-break:break-word;&quot;&gt;4 TRẠNG THÁI GIAO DIỆN CHUẨN MỰC TOÀN HỆ THỐNG (STANDARDIZED UI STATES - SEALED CLASS)&lt;/div&gt;
