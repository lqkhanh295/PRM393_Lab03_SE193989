      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #8b5cf6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - List&amp;lt;String&amp;gt; _apiKeys // Pool 10 keys&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - int _currentKeyIndex&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;String&amp;gt; generateFeedbackInsight(...)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;List&amp;lt;String&amp;gt;&amp;gt; recommendEvents(...)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + String _rotateToNextKey() // on HTTP 429&lt;/div&gt;&lt;/div&gt;
