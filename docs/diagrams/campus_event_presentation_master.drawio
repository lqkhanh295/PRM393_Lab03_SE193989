      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;UI-03: ExploreScreen&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Khám phá sự kiện&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Tìm kiếm không dấu&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Lọc sự kiện theo CLB&lt;/div&gt;&lt;/div&gt;
