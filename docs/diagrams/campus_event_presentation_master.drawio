      <mxCell id="cell_25" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;⏳ 2. STATE LOADING (ĐANG TẢI DỮ LIỆU)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Trong khi chờ kết nối Cloud Firestore / REST&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hiệu ứng Shimmer Skeleton mượt mà.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Giữ nguyên cấu trúc layout của thẻ vé / sự kiện.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tránh giật khung hình (layout shifting).&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hiển thị ngay lập tức khi khởi tạo ViewModel.&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="440" y="825" width="350" height="250" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_26" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#b91c1c; line-height:1.3; word-break:break-word;&quot;&gt;⚠️ 3. STATE ERROR (XỬ LÝ LỖI)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Khi gặp lỗi kết nối mạng hoặc phân quyền&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #ef4444; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Bắt lỗi bằng Try-Catch &amp;amp; Crashlytics.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hiển thị thông báo tiếng Việt dễ hiểu.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tuyệt đối không hiển thị màn hình crash đỏ.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Nút &amp;quot;Thử lại&amp;quot; (Retry) kích hoạt refresh tự động.&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="815" y="825" width="350" height="250" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_27" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#047857; line-height:1.3; word-break:break-word;&quot;&gt;✅ 4. STATE SUCCESS (HIỂN THỊ DỮ LIỆU)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Nạp dữ liệu thật thành công từ Firebase&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hiển thị 100% dữ liệu thực tế từ Cloud.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Cập nhật thời gian thực qua Snapshot Streams.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Đổi màu trạng thái động (Đang mở, Đã đóng).&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Hỗ trợ vuốt xuống để làm mới (Pull-to-Refresh).&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="1190" y="825" width="350" height="250" as="geometry" />
      </mxCell>
    
    </root>
  </mxGraphModel>
</diagram>
