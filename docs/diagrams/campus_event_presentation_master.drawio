      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:4px 8px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:800; color:#2563eb; background:#eff6ff; padding:3px 10px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe; letter-spacing:0.5px;&quot;&gt;SLIDE 10 • TECHNOLOGY STACK&lt;/div&gt;
      &lt;div style=&quot;font-size:19px; font-weight:800; color:#0f172a; line-height:1.2; letter-spacing:-0.2px;&quot;&gt;10. TECHNOLOGY STACK — BẢNG CÔNG NGHỆ THEO NHÓM VÀ VAI TRÒ SỬ DỤNG&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#475569; margin-top:3px; font-weight:500;&quot;&gt;Khớp 100% mã nguồn thực tế và môi trường triển khai của dự án Campus Event Management&lt;/div&gt;
