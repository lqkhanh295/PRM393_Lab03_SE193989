      <mxCell id="cell_20" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;TRẠNG THÁI VẬN HÀNH SỰ KIỆN (EVENT OPERATIONAL STATUS)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Đồng bộ thời gian thực theo DateTime.now() và khung giờ tổ chức&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#8b5cf6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="40" y="575" width="730" height="480" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_21" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;UPCOMING (Sắp diễn ra)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;now &amp;lt; startDate&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Mở đăng ký vé [BR-03]&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Đếm ngược ngày diễn ra&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="70" y="670" width="185" height="95" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_22" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#047857; line-height:1.3; word-break:break-word;&quot;&gt;HAPPENING (Đang diễn ra)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;startDate &amp;lt;= now &amp;lt;= endDate&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Mở cổng soát vé MobileDesk&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Live Companion Q&amp;amp;A&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="335" y="670" width="195" height="95" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_23" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#0f172a; line-height:1.3; word-break:break-word;&quot;&gt;COMPLETED (Đã diễn ra)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;now &amp;gt; endDate&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #64748b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Đóng cổng soát vé&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Tổng kết viễn trắc&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="605" y="670" width="155" height="95" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_24" value="bắt đầu [giờ G]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#0f172a;labelBackgroundColor=#ffffff;labelBorderColor=#94a3b8;arcSize=4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cell_21" target="cell_22">
        <mxGeometry relative="1" as="geometry">
          <mxPoint as="offset" x="0" y="-14" />
        </mxGeometry>
      </mxCell>
    
      
      <mxCell id="cell_25" value="kết thúc [hết giờ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#0f172a;labelBackgroundColor=#ffffff;labelBorderColor=#94a3b8;arcSize=4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cell_22" target="cell_23">
        <mxGeometry relative="1" as="geometry">
          <mxPoint as="offset" x="0" y="-14" />
        </mxGeometry>
      </mxCell>
    
      
      <mxCell id="cell_26" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#0f172a; line-height:1.3; word-break:break-word;&quot;&gt;QUY TẮC CHUYỂN TRẠNG THÁI TỰ ĐỘNG CỦA SỰ KIỆN:&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Tính toán động (Dynamic Computation) dựa trên thời gian thực tế của hệ thống&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #64748b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • EventModel.isPast: Tự động chuyển true khi thời điểm hiện tại vượt qua thời điểm kết thúc sự kiện.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • EventModel.isRegistrationOpen: Đóng đăng ký (false) ngay khi sự kiện bắt đầu hoặc khi hết chỗ.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Trạng thái Cổng MobileDesk: Tự động chuyển từ &amp;quot;Chưa mở&amp;quot; sang &amp;quot;Đang mở cổng&amp;quot; khi sự kiện diễn ra.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • Tuân thủ nghiêm ngặt Chính sách Zero-Mock Data: Mọi mốc thời gian đều so khớp với DateTime.now() thật.&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="70" y="810" width="680" height="215" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_27" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#b91c1c; line-height:1.3; word-break:break-word;&quot;&gt;CÁC CHUYỂN TRẠNG THÁI BỊ CẤM &amp;amp; RÀNG BUỘC TOÀN VẸN (FORBIDDEN TRANSITIONS)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Bắt buộc kiểm thử tự động (Unit Test / Integration Test) để ngăn chặn lỗ hổng bảo mật&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #ef4444; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• ❌ CẤM: PENDING ➔ USED — Đơn chưa được CTSV duyệt tuyệt đối không được phép soát vé vào cổng.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• ❌ CẤM: USED ➔ ISSUED — Vé đã check-in không được phép hoàn lại trạng thái chưa quét (Chống tấn công Replay Attack).&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• ❌ CẤM: EXPIRED ➔ USED — Vé của sự kiện đã kết thúc trong quá khứ không được phép check-in tại cổng.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• ❌ CẤM: PENDING ➔ FEEDBACK_DONE — Sinh viên chưa tham dự sự kiện không được phép gửi đánh giá hay nhận điểm.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• ❌ CẤM: DRAFT ➔ APPROVED — Phải đi qua hàng chờ PENDING để có vết kiểm toán (Audit Trail) của cán bộ CTSV.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• 🔒 BẢO VỆ ATOMIC: Mọi thao tác đổi trạng thái vé và duyệt đơn đều chạy qua Firestore RunTransaction bảo đảm tính nhất quán cao.&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• 🧪 MINH CHỨNG KIỂM THỬ: Bộ kiểm thử test/widget_test.dart đã xác nhận toàn bộ 21/21 kịch bản kiểm thử pass 100%.&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="790" y="575" width="760" height="480" as="geometry" />
      </mxCell>
    
    </root>
  </mxGraphModel>
</diagram>
  <diagram id="09_System_Architecture" name="09_System_Architecture">
  <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" background="#ffffff">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      
      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:4px 8px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:800; color:#2563eb; background:#eff6ff; padding:3px 10px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe; letter-spacing:0.5px;&quot;&gt;SLIDE 09 • SYSTEM ARCHITECTURE&lt;/div&gt;
      &lt;div style=&quot;font-size:19px; font-weight:800; color:#0f172a; line-height:1.2; letter-spacing:-0.2px;&quot;&gt;09. SYSTEM ARCHITECTURE — KIẾN TRÚC HỆ THỐNG &amp;amp; NƠI TRIỂN KHAI&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#475569; margin-top:3px; font-weight:500;&quot;&gt;Mô hình C4 Container: Client Presentation Layer ➔ Business Service Layer ➔ Google Firebase Cloud Backend&lt;/div&gt;
    &lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
        <mxGeometry x="40" y="15" width="1100" height="75" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_2" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;TẦNG GIAO DIỆN &amp;amp; TRẢI NGHIỆM KHÁCH (CLIENT PRESENTATION LAYER)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Đa nền tảng: Ứng dụng Di động Native (Sinh viên, CTV) &amp;amp; Cổng Quản trị Web Desktop (Cán bộ CTSV)&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="40" y="100" width="1510" height="235" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px 12px; text-align:left; box-sizing:border-box; width:100%; height:100%;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:800; color:#1d4ed8; line-height:1.3; word-break:break-word;&quot;&gt;📱 Mobile Client — Flutter 3.24 / Dart 3.5 (iOS &amp;amp; Android)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Kiến trúc MVVM sạch, phân tách giao diện và trạng thái dữ liệu (Provider Pattern)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Screens: HomeScreen, ExploreScreen, EventDetailScreen, DigitalTicketScreen, LiveCompanionScreen, MobileDeskScreen&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• State Management: AuthViewModel, ExploreViewModel, RegistrationViewModel, MyTicketsViewModel, LiveEventViewModel&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Hardware Access: Camera Scanner QR (1.5s/lượt), Push Notifications (FCM), Local Storage Cache&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="70" y="155" width="700" height="155" as="geometry" />
