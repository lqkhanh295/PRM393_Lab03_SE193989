      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #64748b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • id: string [PK, &amp;quot;fcode&amp;quot;, &amp;quot;cocsaigon&amp;quot;]&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • name: string [Tên chính thức]&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • acronym: string [&amp;quot;F-Code&amp;quot;]&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • category: string [&amp;quot;Technology&amp;quot; | &amp;quot;Media&amp;quot;]&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • followerCount: number&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• • logoUrl: string, fanpageUrl: string&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
