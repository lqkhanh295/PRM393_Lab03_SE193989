      <mxCell id="cell_14" value="chứng nhận (1,1 ➔ 0,1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=1.5;dashed=0;fontFamily=Segoe UI;fontSize=10;fontStyle=1;fontColor=#0f172a;labelBackgroundColor=#ffffff;labelBorderColor=#94a3b8;arcSize=4;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="cell_6" target="cell_8">
