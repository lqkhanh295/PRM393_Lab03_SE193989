    <mxCell id="box_client" value="TẦNG GIAO DIỆN &amp; TRẢI NGHIỆM NGƯỜI DÙNG (CLIENT PRESENTATION LAYER)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontSize=13;fontColor=#0F172A;rounded=1;shadow=1;startSize=30;arcSize=4;" parent="1" vertex="1"   >
