      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Mở cổng soát vé MobileDesk&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• Live Companion Q&amp;amp;A&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="335" y="670" width="195" height="95" as="geometry" />
