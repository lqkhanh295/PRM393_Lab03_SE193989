      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #f59e0b; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - FirestoreService _firestoreService&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + int scannedCount, totalCapacity&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + double processingSpeedSeconds&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;bool&amp;gt; scanQrToken(String token)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + void switchMonitoredEvent(String eventId)&lt;/div&gt;&lt;/div&gt;
