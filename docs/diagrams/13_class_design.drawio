      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #10b981; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - FirebaseFirestore _db&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;EventModel&amp;gt;&amp;gt; getEventsStream()&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;TicketModel&amp;gt;&amp;gt; getTicketsStream(String uid)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitRegistration(RegistrationModel reg)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; approveRegistration(String regId)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;bool&amp;gt; checkInTicket(String qrToken) // RunTransaction&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitFeedback(FeedbackModel fb)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; updateActivityPoints(String uid, int pts)&lt;/div&gt;&lt;/div&gt;
