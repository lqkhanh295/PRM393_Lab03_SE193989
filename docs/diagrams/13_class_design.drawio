      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;EventModel&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Entity sự kiện trường FPT&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #60a5fa; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + String id, title, description, location&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + DateTime date, String timeRange&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + String clubName, category&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + int capacity, registeredCount&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + String status // upcoming, happening, completed&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + bool get isPast =&amp;gt; DateTime.now().isAfter(date)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + bool get isRegistrationOpen&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + fromMap(Map json), toMap(): Map&amp;lt;String, dynamic&amp;gt;&lt;/div&gt;&lt;/div&gt;
