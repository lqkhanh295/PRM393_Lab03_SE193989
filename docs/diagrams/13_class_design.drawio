      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;FirestoreService&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Cung cấp toàn bộ thao tác cơ sở dữ liệu thật&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #34d399; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• - FirebaseFirestore _db&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;EventModel&amp;gt;&amp;gt; getEventsStream()&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;TicketModel&amp;gt;&amp;gt; getTicketsStream(String uid)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitRegistration(RegistrationModel reg)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; approveRegistration(String regId)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;bool&amp;gt; checkInTicket(String qrToken) // RunTransaction&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitFeedback(FeedbackModel fb)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; updateActivityPoints(String uid, int pts)&lt;/div&gt;&lt;/div&gt;
