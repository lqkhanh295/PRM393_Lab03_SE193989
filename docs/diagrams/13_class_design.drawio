      &lt;div style=&quot;font-size:12px; font-weight:800; color:#6d28d9; line-height:1.3; word-break:break-word;&quot;&gt;RegistrationViewModel&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.35; font-weight:500; word-break:break-word;&quot;&gt;Điều khiển luồng nộp đơn và duyệt (Slide 18)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #8b5cf6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - FirestoreService _firestoreService&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + UIState&amp;lt;RegistrationModel&amp;gt; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitRegistration(EventModel event)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;RegistrationModel&amp;gt;&amp;gt; streamPending()&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; approve(String regId)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; reject(String regId, String reason)&lt;/div&gt;&lt;/div&gt;
