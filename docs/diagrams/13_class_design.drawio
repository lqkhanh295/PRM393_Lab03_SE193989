      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #3b82f6; font-size:10px; color:#1e293b; line-height:1.45; word-break:break-word;&quot;&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• - AuthService _authService&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + UserModel? get currentUser&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; signInWithEmailPassword(...)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; signInWithGoogle()&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; addActivityPoints(int points)&lt;/div&gt;&lt;div style=&quot;margin-bottom:3px;&quot;&gt;• + Future&amp;lt;void&amp;gt; signOut()&lt;/div&gt;&lt;/div&gt;
