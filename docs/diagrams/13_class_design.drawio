      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #c084fc; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• - FirestoreService _firestoreService&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + UIState&amp;lt;RegistrationModel&amp;gt; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; submitRegistration(EventModel event)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Stream&amp;lt;List&amp;lt;RegistrationModel&amp;gt;&amp;gt; streamPending()&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; approve(String regId)&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• + Future&amp;lt;void&amp;gt; reject(String regId, String reason)&lt;/div&gt;&lt;/div&gt;
