  <diagram id="09_System_Architecture" name="09_System_Architecture">
  <mxGraphModel dx="1450" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1000" background="#ffffff">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      
      <mxCell id="cell_1" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; text-align:left; padding:8px 12px;&quot;&gt;
      &lt;div style=&quot;display:inline-block; font-size:10px; font-weight:700; color:#2563eb; background:#eff6ff; padding:2px 8px; border-radius:12px; margin-bottom:4px; border:1px solid #bfdbfe;&quot;&gt;SLIDE 09 • SYSTEM ARCHITECTURE&lt;/div&gt;
      &lt;div style=&quot;font-size:18px; font-weight:800; color:#0f172a; line-height:1.2;&quot;&gt;09. SYSTEM ARCHITECTURE — KIẾN TRÚC HỆ THỐNG &amp;amp; NƠI TRIỂN KHAI&lt;/div&gt;
      &lt;div style=&quot;font-size:11px; color:#64748b; margin-top:2px;&quot;&gt;Mô hình C4 Container: Client Presentation Layer ➔ Business Service Layer ➔ Google Firebase Cloud Backend&lt;/div&gt;
    &lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1">
        <mxGeometry x="40" y="20" width="700" height="65" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_2" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;TẦNG GIAO DIỆN &amp;amp; TRẢI NGHIỆM KHÁCH (CLIENT PRESENTATION LAYER)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Đa nền tảng: Ứng dụng Di động Native (Sinh viên, CTV) &amp;amp; Cổng Quản trị Web Desktop (Cán bộ CTSV)&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="40" y="100" width="1370" height="220" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_3" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;📱 Mobile Client — Flutter 3.24 / Dart 3.5 (iOS &amp;amp; Android)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Kiến trúc MVVM sạch, phân tách giao diện và trạng thái dữ liệu (Provider Pattern)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #60a5fa; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• Screens: HomeScreen, ExploreScreen, EventDetailScreen, DigitalTicketScreen, LiveCompanionScreen, MobileDeskScreen&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• State Management: AuthViewModel, ExploreViewModel, RegistrationViewModel, MyTicketsViewModel, LiveEventViewModel&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• Hardware Access: Camera Scanner QR (1.5s/lượt), Push Notifications (FCM), Local Storage Cache&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="70" y="155" width="630" height="140" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_4" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;💻 Desktop Web Admin Portal — Vanilla JS / Modern CSS / Node.js Express Bridge (Port 3000)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Hệ thống bảng điều khiển trung tâm dành cho Cán bộ Phòng Chăm sóc Sinh viên (CTSV)&lt;/div&gt;
      &lt;div style=&quot;margin-top:6px; padding-top:6px; border-top:1px dashed #c084fc; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• 9 Module Chuyên Sâu: Live KPI Monitor, Hàng chờ duyệt vé (Slide 18), Thẩm định ngân sách CLB, An toàn hội trường&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• Realtime Telemetry: Bảng đối chiếu tiến độ check-in, giám sát lưu lượng vào cổng theo giây, quản lý sự kiện&lt;/div&gt;&lt;div style=&quot;margin-bottom:2px;&quot;&gt;• Bảo mật: Google Identity Token, Session Cookie, REST API Bridge tự động refresh token định danh&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#faf5ff;strokeColor=#c084fc;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="730" y="155" width="650" height="140" as="geometry" />
      </mxCell>
    
      
      <mxCell id="cell_5" value="&lt;div style=&quot;font-family:Segoe UI, sans-serif; padding:10px; text-align:left; box-sizing:border-box;&quot;&gt;
      &lt;div style=&quot;font-size:12px; font-weight:700; color:#0f172a; line-height:1.3;&quot;&gt;TẦNG DỊCH VỤ &amp;amp; NGHIỆP VỤ HỆ THỐNG (BUSINESS SERVICE LAYER - LIB/SERVICES/)&lt;/div&gt;
      &lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px; line-height:1.3;&quot;&gt;Tập trung toàn bộ logic nghiệp vụ độc lập, đóng gói REST API và SDK giao tiếp&lt;/div&gt;
      
    &lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;overflow=hidden;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;shadow=0;verticalAlign=top;align=left;" vertex="1" parent="1">
        <mxGeometry x="40" y="350" width="1370" height="180" as="geometry" />
